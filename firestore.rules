rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function perms() {
      return get(/databases/$(database)/documents/userPermissions/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuth() && perms().isAdmin == true;
    }

    function canWriteUniverso(universoId) {
      return isAdmin() ||
             (isAuth() && universoId in perms().universos);
    }

    // Aptidões, Regras e Condições podem pertencer a mais de um universo
    // (`universos`, lista de ids); docs antigos ainda podem ter apenas o
    // campo singular `universo`.
    // Lista vazia é tratada como "sem universo" (não editável por não-admin):
    // `[].hasOnly(x)` é vacuamente verdadeiro em CEL, então sem o check de
    // `size() > 0` qualquer usuário autenticado — mesmo sem nenhum universo
    // liberado — passaria nesta checagem.
    function canWriteUniversos(universoIds) {
      return isAdmin() ||
             (isAuth() && universoIds.size() > 0 && universoIds.hasOnly(perms().universos));
    }

    // O fallback do campo singular `universo` só se aplica quando o doc não
    // tem `universos` como lista — se `universos` existe (mesmo vazia), ela é
    // a fonte da verdade. Sem essa exclusão, um doc migrado que ainda carrega
    // os dois campos (`universos: [A,B,C]` e o antigo `universo: "A"`) seria
    // liberado para quem só tem acesso a A, ignorando que B e C exigem
    // permissão própria.
    function canWriteMultiUniversoData(data) {
      return isAdmin() ||
        (isAuth() && (
          (data.universos is list && data.universos.size() > 0 && data.universos.hasOnly(perms().universos)) ||
          (!(data.universos is list) && data.universo is string && data.universo in perms().universos)
        ));
    }

    // Permite atualizar só o campo `universos` (add/remove) de um doc
    // multi-universo sem exigir acesso a todos os universos já presentes —
    // basta ter acesso aos universos que estão sendo adicionados/removidos.
    // Usado para permitir que um usuário associe/desassocie um doc (ex.:
    // Aptidões) do(s) universo(s) que ele administra, mesmo que o doc já
    // pertença a outros universos que ele não administra.
    function canTogglePartialUniverso(antes, depois) {
      return isAuth() &&
        antes.universos is list && depois.universos is list &&
        depois.diff(antes).affectedKeys().hasOnly(['universos', 'updatedAt']) &&
        depois.universos.removeAll(antes.universos).hasOnly(perms().universos) &&
        antes.universos.removeAll(depois.universos).hasOnly(perms().universos);
    }

    // ── userPermissions ────────────────────────────────────────────────────────
    // Cada usuário lê o próprio documento; além disso, quem compartilha
    // permissão de escrita em pelo menos um Universo com o dono do doc também
    // pode ler (usado pelo Re:Master para resolver uid → nome do usuário que
    // criou uma ficha de NPC/Criatura/Jogador, quando esse usuário não é quem
    // está logado). Apenas admins podem escrever.
    match /userPermissions/{userId} {
      allow read: if isAuth() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (resource.data.universos is list &&
         resource.data.universos.hasAny(perms().universos))
      );
      allow write: if isAdmin();
    }

    // ── Universo ───────────────────────────────────────────────────────────────
    // Leitura para qualquer usuário autenticado; escrita apenas para admins.
    match /Universo/{universoId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── racas ──────────────────────────────────────────────────────────────────
    // Leitura para qualquer usuário autenticado.
    // Escrita (create/update/delete) baseada no campo `universo` do documento.
    // - create: o universo do novo doc deve ser permitido ao usuário
    // - update: o universo do doc antigo E do novo devem ser permitidos
    //           (impede mover uma raça para outro universo sem permissão)
    // - delete: o universo do doc existente deve ser permitido
    match /racas/{racaId} {
      allow read: if isAuth();
      allow create: if canWriteUniverso(request.resource.data.universo);
      allow update: if canWriteUniverso(resource.data.universo)
                    && canWriteUniverso(request.resource.data.universo);
      allow delete: if canWriteUniverso(resource.data.universo);
    }

    // ── classes ────────────────────────────────────────────────────────────────
    match /classes/{classeId} {
      allow read: if isAuth();
      allow create: if canWriteUniverso(request.resource.data.universo);
      allow update: if canWriteUniverso(resource.data.universo)
                    && canWriteUniverso(request.resource.data.universo);
      allow delete: if canWriteUniverso(resource.data.universo);
    }

    // ── materiais ──────────────────────────────────────────────────────────────
    match /materiais/{materialId} {
      allow read: if isAuth();
      allow create: if canWriteUniverso(request.resource.data.universo);
      allow update: if canWriteUniverso(resource.data.universo)
                    && canWriteUniverso(request.resource.data.universo);
      allow delete: if canWriteUniverso(resource.data.universo);
    }

    // ── itens ──────────────────────────────────────────────────────────────────
    match /itens/{itemId} {
      allow read: if isAuth();
      allow create: if canWriteUniverso(request.resource.data.universo);
      allow update: if canWriteUniverso(resource.data.universo)
                    && canWriteUniverso(request.resource.data.universo);
      allow delete: if canWriteUniverso(resource.data.universo);
    }

    // ── receitas ───────────────────────────────────────────────────────────────
    match /receitas/{receitaId} {
      allow read: if isAuth();
      allow create: if canWriteUniverso(request.resource.data.universo);
      allow update: if canWriteUniverso(resource.data.universo)
                    && canWriteUniverso(request.resource.data.universo);
      allow delete: if canWriteUniverso(resource.data.universo);
    }

    // ── condicoes ──────────────────────────────────────────────────────────────
    // Escrita baseada no campo `universos` (lista de ids) do documento —
    // condições podem pertencer a mais de um universo.
    match /condicoes/{condicaoId} {
      allow read: if isAuth();
      allow create: if canWriteUniversos(request.resource.data.universos);
      allow update: if canWriteMultiUniversoData(resource.data)
                    && canWriteUniversos(request.resource.data.universos);
      allow delete: if canWriteMultiUniversoData(resource.data);
    }

    // ── artes ──────────────────────────────────────────────────────────────────
    match /artes/{arteId} {
      allow read: if isAuth();
      allow create: if canWriteUniverso(request.resource.data.universo);
      allow update: if canWriteUniverso(resource.data.universo)
                    && canWriteUniverso(request.resource.data.universo);
      allow delete: if canWriteUniverso(resource.data.universo);
    }

    // ── origens ────────────────────────────────────────────────────────────────
    match /origens/{origemId} {
      allow read: if isAuth();
      allow create: if canWriteUniverso(request.resource.data.universo);
      allow update: if canWriteUniverso(resource.data.universo)
                    && canWriteUniverso(request.resource.data.universo);
      allow delete: if canWriteUniverso(resource.data.universo);
    }

    // ── regras ─────────────────────────────────────────────────────────────────
    // Escrita baseada no campo `universos` (lista de ids) do documento —
    // regras podem pertencer a mais de um universo.
    match /regras/{regraId} {
      allow read: if isAuth();
      allow create: if canWriteUniversos(request.resource.data.universos);
      allow update: if canWriteMultiUniversoData(resource.data)
                    && canWriteUniversos(request.resource.data.universos);
      allow delete: if canWriteMultiUniversoData(resource.data);
    }

    // ── cardflux ───────────────────────────────────────────────────────────────
    match /cardflux/{cardFluxId} {
      allow read: if isAuth();
      allow create: if canWriteUniverso(request.resource.data.universo);
      allow update: if canWriteUniverso(resource.data.universo)
                    && canWriteUniverso(request.resource.data.universo);
      allow delete: if canWriteUniverso(resource.data.universo);
    }

    // ── veiasAstrais ───────────────────────────────────────────────────────────
    match /veiasAstrais/{veiaAstralId} {
      allow read: if isAuth();
      allow create: if canWriteUniverso(request.resource.data.universo);
      allow update: if canWriteUniverso(resource.data.universo)
                    && canWriteUniverso(request.resource.data.universo);
      allow delete: if canWriteUniverso(resource.data.universo);
    }

    // ── divindades ─────────────────────────────────────────────────────────────
    match /divindades/{divindadeId} {
      allow read: if isAuth();
      allow create: if canWriteUniverso(request.resource.data.universo);
      allow update: if canWriteUniverso(resource.data.universo)
                    && canWriteUniverso(request.resource.data.universo);
      allow delete: if canWriteUniverso(resource.data.universo);
    }

    // ── aptidoes ───────────────────────────────────────────────────────────────
    // Escrita baseada no campo `universos` (lista de ids) do documento —
    // aptidões podem pertencer a mais de um universo.
    match /aptidoes/{aptidaoId} {
      allow read: if isAuth();
      allow create: if canWriteUniversos(request.resource.data.universos);
      allow update: if (canWriteMultiUniversoData(resource.data)
                    && canWriteUniversos(request.resource.data.universos))
                    || canTogglePartialUniverso(resource.data, request.resource.data);
      allow delete: if canWriteMultiUniversoData(resource.data);
    }

    // ── corposEspeciais ──────────────────────────────────────────────────────
    match /corposEspeciais/{corpoEspecialId} {
      allow read: if isAuth();
      allow create: if canWriteUniverso(request.resource.data.universo);
      allow update: if canWriteUniverso(resource.data.universo)
                    && canWriteUniverso(request.resource.data.universo);
      allow delete: if canWriteUniverso(resource.data.universo);
    }

    // ── reinosCultivo ────────────────────────────────────────────────────────
    match /reinosCultivo/{reinoCultivoId} {
      allow read: if isAuth();
      allow create: if canWriteUniverso(request.resource.data.universo);
      allow update: if canWriteUniverso(resource.data.universo)
                    && canWriteUniverso(request.resource.data.universo);
      allow delete: if canWriteUniverso(resource.data.universo);
    }

    // ── tricksterCoin ───────────────────────────────────────────────────────
    // Coleção administrativa de benefícios da Trickster Coin. O acesso é
    // restrito ao mesmo gate de administração já usado pelo banco:
    // usuário autenticado + documento `userPermissions/{uid}` com `isAdmin == true`.
    match /tricksterCoin/{benefitId} {
      allow read: if isAuth();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── personagens ──────────────────────────────────────────────────────
    // Cada usuário só escreve os próprios personagens (uid == request.auth.uid).
    // Leitura liberada para qualquer autenticado, independente do `tipo`: NPC
    // e Criatura já eram públicos como conteúdo de referência para o
    // Re:Master importar; "Personagem Jogável" também precisa ser legível por
    // qualquer mestre autenticado para a tela de Jogadores do Re:Master (lista
    // de personagens jogáveis vinculados a uma campanha, via campo
    // `campanhas`) — não há como restringir a leitura só ao mestre dono da
    // campanha vinculada sem iterar `campanhas` em regra, o que a linguagem
    // de regras do Firestore não suporta.
    match /personagens/{personagemId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;

      // Subcoleções (aptidoesAdquiridas, arts, historicoSorte — Fases futuras).
      // Escrita: só o dono do documento pai (uid), como antes.
      // Leitura: dono OU qualquer usuário com permissão de escrita no Universo
      // do personagem (`data.universo`) — liberado para o Re:Master mostrar a
      // ficha completa de NPCs/Criaturas importados de outro autor dentro do
      // mesmo Universo (antes só o dono via Re-Dungeon enxergava essas abas).
      match /{subcolecao}/{docId} {
        allow read: if isAuth() &&
          (get(/databases/$(database)/documents/personagens/$(personagemId)).data.uid
             == request.auth.uid ||
           canWriteUniverso(
             get(/databases/$(database)/documents/personagens/$(personagemId)).data.universo));
        allow write: if isAuth()
          && get(/databases/$(database)/documents/personagens/$(personagemId)).data.uid
             == request.auth.uid;
      }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Re:Master — coleções novas (prefixo `rm`), acrescentadas sem alterar
    // nenhuma linha acima. Diferente das coleções do Re-Dungeon (públicas
    // para qualquer autenticado), o conteúdo do Re:Master é privado do
    // mestre — sem visão de jogador em nenhum dos módulos atuais — então
    // leitura E escrita ficam restritas ao mestre dono da campanha.
    // ═══════════════════════════════════════════════════════════════════════

    // Cada Campanha (e tudo vinculado a ela) é privada ao mestre que a criou,
    // mesmo que outro colaborador tenha acesso de escrita ao mesmo Universo —
    // evita que dois mestres rodando campanhas diferentes no mesmo mundo
    // vejam segredos de NPC/consequências um do outro.
    function isCampanhaOwner(mestreId) {
      return isAuth() && mestreId == request.auth.uid;
    }

    // Todo documento das coleções abaixo denormaliza `universoId` e
    // `mestreId` (evita `get()` extra por regra), então a checagem é sempre a
    // mesma — só muda o nome da coleção.
    match /rmCampanhas/{campanhaId} {
      allow read: if isAuth();
      allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);
      allow update: if isAdmin() ||
        (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));
      allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);

      // Clones de NPC específicos desta campanha (feitos a partir de um
      // personagem tipo NPC do Universo). Subcoleção — não coleção `rm`
      // top-level — porque o clone só existe no escopo de uma Campanha; os
      // docs denormalizam universoId/mestreId como as demais, então a
      // checagem é idêntica à do documento pai.
      match /npcs/{npcId} {
        allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
        allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);
        allow update: if isAdmin() ||
          (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));
        allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
      }

      // Clones de Personagem Jogável específicos desta campanha (feitos a
      // partir de um personagem tipo Personagem Jogável do Universo) — mesmo
      // padrão da subcoleção `npcs` acima.
      match /jogadores/{jogadorId} {
        allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
        allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);
        allow update: if isAdmin() ||
          (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));
        allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
      }

      // Clones de Criatura específicos desta campanha (feitos a partir de um
      // personagem tipo Criatura do Universo) — mesmo padrão das subcoleções
      // `npcs`/`jogadores` acima.
      match /criaturas/{criaturaId} {
        allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
        allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);
        allow update: if isAdmin() ||
          (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));
        allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
      }

      // Participantes da tela de Luta desta campanha (cópias de NPC/Criatura
      // com estado de combate próprio, inclusive duplicatas do mesmo
      // personagem de origem) — mesmo padrão das subcoleções acima.
      match /lutaParticipantes/{participanteId} {
        allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
        allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);
        allow update: if isAdmin() ||
          (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));
        allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
      }
    }

    match /rmCenas/{docId} {
      allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
      allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);
      allow update: if isAdmin() ||
        (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));
      allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
    }

    match /rmCenaConexoes/{docId} {
      allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
      allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);
      allow update: if isAdmin() ||
        (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));
      allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
    }

    match /rmMapas/{docId} {
      allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
      allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);
      allow update: if isAdmin() ||
        (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));
      allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
    }

    match /rmMapasPastas/{docId} {
      allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
      allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);
      allow update: if isAdmin() ||
        (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));
      allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
    }

    match /rmMissoes/{docId} {
      allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
      allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);
      allow update: if isAdmin() ||
        (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));
      allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
    }

    match /rmCardfluxEstados/{docId} {
      allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
      allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);
      allow update: if isAdmin() ||
        (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));
      allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
    }

    match /rmCardfluxExploracoes/{docId} {
      allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
      allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);
      allow update: if isAdmin() ||
        (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));
      allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
    }

    match /rmNotas/{docId} {
      allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
      allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);
      allow update: if isAdmin() ||
        (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));
      allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
    }

    match /rmTiposEntidade/{docId} {
      allow read: if isAdmin() ||
        (isAuth() &&
          resource.data.mestreId == request.auth.uid &&
          canWriteUniverso(resource.data.universoId));
      allow create: if isAuth() &&
        request.resource.data.mestreId == request.auth.uid &&
        canWriteUniverso(request.resource.data.universoId);
      allow update: if isAdmin() ||
        (isAuth() &&
          resource.data.mestreId == request.auth.uid &&
          request.resource.data.mestreId == request.auth.uid &&
          resource.data.universoId == request.resource.data.universoId &&
          canWriteUniverso(request.resource.data.universoId));
      allow delete: if isAdmin() ||
        (isAuth() &&
          resource.data.mestreId == request.auth.uid &&
          canWriteUniverso(resource.data.universoId));
    }

    // Biblioteca global de músicas do mestre — só o dono do conteúdo pode
    // publicar/editar/excluir suas músicas, pastas e playlists. A regra usa
    // `mestreId` para impedir que um mestre altere registros de outro.
    function musicaBibliotecaValida(data) {
      return (
        (
          data.keys().hasOnly(['nome', 'url', 'videoId', 'pastaId', 'tags', 'descricao',
                                'thumbnailUrl', 'duracaoSegundos', 'mestreId', 'createdAt']) ||
          data.keys().hasOnly(['nome', 'url', 'videoId', 'pastaId', 'tags', 'descricao',
                                'thumbnailUrl', 'duracaoSegundos', 'mestreId', 'createdAt', 'updatedAt'])
        ) &&
        data.mestreId == request.auth.uid &&
        data.nome is string && data.nome.size() > 0 && data.nome.size() <= 200 &&
        data.url is string && data.url.size() <= 2000 && data.url.matches('https://.+') &&
        data.videoId is string && data.videoId.matches('[A-Za-z0-9_-]{11}') &&
        (data.pastaId == null || (data.pastaId is string && data.pastaId.size() <= 200)) &&
        data.tags is list && data.tags.size() <= 20 &&
        data.descricao is string && data.descricao.size() <= 2000 &&
        (data.thumbnailUrl == null || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 2000)) &&
        (data.duracaoSegundos == null || (data.duracaoSegundos is number && data.duracaoSegundos >= 0))
      );
    }

    function musicaPastaValida(data) {
      return (
        (
          data.keys().hasOnly(['nome', 'descricao', 'cor', 'ordenacao', 'mestreId', 'createdAt']) ||
          data.keys().hasOnly(['nome', 'descricao', 'cor', 'ordenacao', 'mestreId', 'createdAt', 'updatedAt'])
        ) &&
        data.mestreId == request.auth.uid &&
        data.nome is string && data.nome.size() > 0 && data.nome.size() <= 200 &&
        data.descricao is string && data.descricao.size() <= 2000 &&
        data.cor is string && data.cor.matches('#[0-9a-fA-F]{6}') &&
        data.ordenacao is int && data.ordenacao >= 0
      );
    }

    function playlistBibliotecaValida(data) {
      return (
        (
          data.keys().hasOnly(['nome', 'descricao', 'linkImagem', 'pastaId', 'musicas', 'mestreId', 'createdAt']) ||
          data.keys().hasOnly(['nome', 'descricao', 'linkImagem', 'pastaId', 'musicas', 'mestreId', 'createdAt', 'updatedAt'])
        ) &&
        data.mestreId == request.auth.uid &&
        data.nome is string && data.nome.size() > 0 && data.nome.size() <= 200 &&
        data.descricao is string && data.descricao.size() <= 2000 &&
        (data.linkImagem == null || (data.linkImagem is string && data.linkImagem.size() <= 2000)) &&
        (data.pastaId == null || (data.pastaId is string && data.pastaId.size() <= 200)) &&
        data.musicas is list && data.musicas.size() <= 200
      );
    }

    match /rmMusicasBiblioteca/{docId} {
      allow read: if isAdmin() || (isAuth() && resource.data.mestreId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.mestreId == request.auth.uid && musicaBibliotecaValida(request.resource.data);
      allow update: if isAdmin() ||
        (isAuth() && resource.data.mestreId == request.auth.uid && request.resource.data.mestreId == request.auth.uid && musicaBibliotecaValida(request.resource.data));
      allow delete: if isAdmin() || (isAuth() && resource.data.mestreId == request.auth.uid);
    }

    match /rmMusicasPastas/{docId} {
      allow read: if isAdmin() || (isAuth() && resource.data.mestreId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.mestreId == request.auth.uid && musicaPastaValida(request.resource.data);
      allow update: if isAdmin() ||
        (isAuth() && resource.data.mestreId == request.auth.uid && request.resource.data.mestreId == request.auth.uid && musicaPastaValida(request.resource.data));
      allow delete: if isAdmin() || (isAuth() && resource.data.mestreId == request.auth.uid);
    }

    match /rmPlaylists/{docId} {
      allow read: if isAdmin() || (isAuth() && resource.data.mestreId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.mestreId == request.auth.uid && playlistBibliotecaValida(request.resource.data);
      allow update: if isAdmin() ||
        (isAuth() && resource.data.mestreId == request.auth.uid && request.resource.data.mestreId == request.auth.uid && playlistBibliotecaValida(request.resource.data));
      allow delete: if isAdmin() || (isAuth() && resource.data.mestreId == request.auth.uid);
    }

    // Registro cronológico automático de eventos da sessão (cena marcada
    // como atual, carta sorteada, participante entrou na Luta) — só leitura
    // e criação (append-only por design, ver storage.js): nenhuma tela edita
    // ou apaga uma entrada de log já gravada, então update/delete ficam sem
    // `allow` (negados por padrão pelas Firestore Rules).
    match /rmSessaoLogs/{docId} {
      allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);
      allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Chat da campanha — primeiro conteúdo `rm*` visível para jogadores.
    // Acesso: o mestre da campanha (`mestreId` do doc pai) OU um jogador cujo
    // personagem (dele, `uid`) tem a campanha em `campanhas`. Admin que não é
    // o mestre NÃO entra (conversa de mesa é privada). Como `personagens` não
    // pode ser consultado por regra, cada jogador grava um ponteiro
    // `chatMembros/{uid}` = {uid, personagemId}; a leitura revalida esse
    // personagem a cada request — desmarcar a campanha na ficha corta o acesso
    // na hora, sem precisar apagar o ponteiro.
    // ═══════════════════════════════════════════════════════════════════════

    function isMestreDaCampanha(campanhaId) {
      return isAuth() &&
        get(/databases/$(database)/documents/rmCampanhas/$(campanhaId)).data.mestreId == request.auth.uid;
    }

    function personagemDoUsuarioNaCampanha(campanhaId, personagemId) {
      let personagem = get(/databases/$(database)/documents/personagens/$(personagemId)).data;
      return isAuth() && personagemId is string &&
        personagem.uid == request.auth.uid &&
        campanhaId in personagem.get('campanhas', []);
    }

    function isMembroDoChat(campanhaId) {
      let membroPath = /databases/$(database)/documents/rmCampanhas/$(campanhaId)/chatMembros/$(request.auth.uid);
      return isAuth() && exists(membroPath) &&
        personagemDoUsuarioNaCampanha(campanhaId, get(membroPath).data.personagemId);
    }

    // Rolagem de dados (common/utils/dados.js): o dado é rolado no cliente e a
    // regra só valida a ESTRUTURA — Firestore Rules não têm laços, então não
    // dá para somar `resultados` nem conferir a faixa de cada dado.
    function chatRolagemValida(rolagem) {
      return rolagem is map &&
        rolagem.keys().hasOnly(['grupos', 'termos', 'modificador', 'total']) &&
        rolagem.keys().hasAll(['grupos', 'termos', 'modificador', 'total']) &&
        rolagem.grupos is list && rolagem.grupos.size() >= 1 && rolagem.grupos.size() <= 10 &&
        rolagem.termos is list && rolagem.termos.size() <= 20 &&
        rolagem.modificador is int && rolagem.total is int;
    }

    // Mensagem de combate do grid (common/utils/chat.js — montarMensagemCombate).
    function chatCombateValido(c) {
      return c is map &&
        c.keys().hasOnly(['evento', 'cenaId', 'rodada', 'nome', 'oculto', 'iniciativa']) &&
        c.keys().hasAll(['evento', 'cenaId']) &&
        c.evento in ['inicio', 'rodada', 'turno', 'fim'] &&
        c.cenaId is string && c.cenaId.size() > 0 && c.cenaId.size() <= 200 &&
        c.get('rodada', 1) is int && c.get('rodada', 1) >= 1 && c.get('rodada', 1) <= 9999 &&
        (c.get('nome', null) == null || (c.nome is string && c.nome.size() <= 100)) &&
        c.get('oculto', false) is bool &&
        c.get('iniciativa', []) is list && c.get('iniciativa', []).size() <= 200;
    }

    // Jogador só anuncia a troca de turno que ele mesmo gravou NESTA escrita
    // ("Encerrar meu turno": transação combate + mensagem — getAfter vê o doc
    // do combate como ficará depois da transação).
    function chatCombateDoJogador(campanhaId, c) {
      return c.evento in ['turno', 'rodada'] &&
        getAfter(/databases/$(database)/documents/rmCampanhas/$(campanhaId)/gridCenas/$(c.cenaId)/combate/atual)
          .data.turnoEm == request.time;
    }

    // Espelha os limites de common/utils/chat.js (CHAT_TEXTO_MAX/CHAT_URL_MAX,
    // PERSONAS). O mestre pode falar como 'mestre', ou interpretar um NPC/
    // Criatura da mesa ('npc'/'criatura', com o nome/avatar dele em
    // autorNome/autorAvatar); jogador é sempre 'jogador'.
    // `secreta`: true só no caminho chatSecretas/{uid}/rolagens (o campo
    // `secreta` do doc tem que bater com o caminho). `tipo: 'combate'`
    // (cartão de combate do grid): o mestre posta qualquer evento; o jogador só
    // turno/rodada junto do passe de turno dele (chatCombateDoJogador).
    function chatMensagemValida(campanhaId, data, secreta) {
      return data.keys().hasOnly(['uid', 'personagemId', 'autorNome', 'autorAvatar', 'isMestre',
                                  'persona', 'tipo', 'texto', 'url', 'rolagem', 'secreta',
                                  'macroNome', 'combate', 'rotulo', 'createdAt']) &&
        data.uid == request.auth.uid &&
        data.createdAt == request.time &&
        data.get('secreta', false) == secreta &&
        data.autorNome is string && data.autorNome.size() > 0 && data.autorNome.size() <= 200 &&
        (data.autorAvatar == null || (data.autorAvatar is string && data.autorAvatar.size() <= 2000)) &&
        data.texto is string && data.texto.size() <= 4000 &&
        ((data.tipo == 'texto' && data.texto.size() > 0 && data.texto.size() <= 2000 &&
          data.url == null && !data.keys().hasAny(['rolagem', 'macroNome', 'combate', 'rotulo'])) ||
         (data.tipo == 'imagem' && data.texto.size() <= 2000 && data.url is string &&
          data.url.size() <= 2000 && data.url.matches('https://.+') &&
          !data.keys().hasAny(['rolagem', 'macroNome', 'combate', 'rotulo'])) ||
         (data.tipo == 'rolagem' && data.texto == '' && data.url == null &&
          !data.keys().hasAny(['macroNome', 'combate']) &&
          chatRolagemValida(data.get('rolagem', null)) &&
          (!('rotulo' in data) ||
           (data.rotulo is string && data.rotulo.size() > 0 && data.rotulo.size() <= 100))) ||
         (data.tipo == 'macro' && data.texto.size() > 0 && data.url == null &&
          !data.keys().hasAny(['rolagem', 'combate', 'rotulo']) && data.macroNome is string &&
          data.macroNome.size() > 0 && data.macroNome.size() <= 100) ||
         (data.tipo == 'combate' && data.texto == '' && data.url == null &&
          !data.keys().hasAny(['rolagem', 'macroNome', 'rotulo']) &&
          chatCombateValido(data.get('combate', null)) &&
          (data.isMestre == true || chatCombateDoJogador(campanhaId, data.combate)))) &&
        ((data.isMestre == true && data.personagemId == null &&
          data.persona in ['mestre', 'npc', 'criatura'] && isMestreDaCampanha(campanhaId)) ||
         (data.isMestre == false && data.persona == 'jogador' &&
          personagemDoUsuarioNaCampanha(campanhaId, data.personagemId)));
    }

    match /rmCampanhas/{campanhaId}/chatMembros/{membroUid} {
      allow read: if isAuth() &&
        (membroUid == request.auth.uid || isMestreDaCampanha(campanhaId));
      allow create, update: if isAuth() && membroUid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'personagemId', 'updatedAt']) &&
        request.resource.data.uid == request.auth.uid &&
        personagemDoUsuarioNaCampanha(campanhaId, request.resource.data.personagemId);
      allow delete: if isAuth() && membroUid == request.auth.uid;
    }

    // Sem update: mensagens não são editáveis (v1). Apagar: autor ou mestre.
    match /rmCampanhas/{campanhaId}/chatMensagens/{mensagemId} {
      allow read: if isMestreDaCampanha(campanhaId) || isMembroDoChat(campanhaId);
      allow create: if isAuth() && chatMensagemValida(campanhaId, request.resource.data, false);
      allow delete: if isAuth() &&
        (resource.data.uid == request.auth.uid || isMestreDaCampanha(campanhaId));
    }

    // Rolagens secretas: uma pasta por usuário — só o dono e o mestre da
    // campanha leem. Os outros jogadores não ficam sabendo que houve rolagem.
    match /rmCampanhas/{campanhaId}/chatSecretas/{donoUid}/rolagens/{rolagemId} {
      allow read: if isAuth() &&
        (donoUid == request.auth.uid || isMestreDaCampanha(campanhaId));
      allow create: if isAuth() && donoUid == request.auth.uid &&
        request.resource.data.tipo == 'rolagem' &&
        chatMensagemValida(campanhaId, request.resource.data, true);
      allow delete: if isAuth() &&
        (donoUid == request.auth.uid || isMestreDaCampanha(campanhaId));
    }

    // Macros Lua da campanha (common/lua/ + common/utils/macros.js). Só o
    // mestre cria/edita/apaga; membros leem as que não são `somenteMestre`
    // (a consulta do jogador filtra `somenteMestre == false`, senão a lista
    // inteira é recusada). Executar uma macro nunca grava aqui — ela roda
    // isolada num Web Worker e só gera mensagens em chatMensagens.
    function chatMacroValida(data) {
      return data.keys().hasOnly(['nome', 'descricao', 'codigo', 'somenteMestre', 'ordem',
                                  'createdAt', 'updatedAt']) &&
        data.nome is string && data.nome.size() > 0 && data.nome.size() <= 100 &&
        data.get('descricao', '') is string && data.get('descricao', '').size() <= 300 &&
        data.codigo is string && data.codigo.size() > 0 && data.codigo.size() <= 51200 &&
        data.somenteMestre is bool &&
        data.ordem is int;
    }

    match /rmCampanhas/{campanhaId}/macros/{macroId} {
      allow read: if isMestreDaCampanha(campanhaId) ||
        (isMembroDoChat(campanhaId) && resource.data.somenteMestre == false);
      allow create, update: if isMestreDaCampanha(campanhaId) &&
        chatMacroValida(request.resource.data);
      allow delete: if isMestreDaCampanha(campanhaId);
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Grid da campanha (common/utils/grid.js) — mesmo acesso do chat, em
    // CENAS: `gridCenas/{cenaId}` (imagem + grade) com os próprios tokens em
    // `gridCenas/{cenaId}/tokens`; `grid/atual` = {cenaAtivaId}. O mestre
    // cria/edita/apaga tudo (Re:Master) e prepara cenas em segredo: o jogador
    // só lê a cena ATIVA e os tokens dela, só MOVE os tokens em que o uid
    // dele está em `donos` (col/lin + o rastro do movimento, rastro/movidoEm) e
    // grava o próprio sinal (`pings/{uid}`). PV/condições/aura/deslocamento
    // dos tokens são só do mestre.
    // Combate (Fase 3A, `gridCenas/{cenaId}/combate/atual`): o mestre grava
    // tudo; o jogador só passa a vez do token dele que está jogando. O
    // `travamento` da cena ('livre' | 'turno' | 'congelado') limita quando o
    // jogador move.
    // Mapa (Fase 3B): `camadas/{paredes,nevoa}` (só o mestre grava), `marcadores`
    // (mestre grava; `secreto` só o mestre lê) e `desenhos` (cada um cria os seus).
    // Tokens `oculto` só o mestre lê — a consulta do jogador filtra
    // `oculto == false` (senão é recusada).
    // ═══════════════════════════════════════════════════════════════════════

    function gridImagemValida(url) {
      return url == null || (url is string && url.size() <= 2000 && url.matches('https://.+'));
    }

    function gridCenaAtiva(campanhaId, cenaId) {
      let ponteiro = /databases/$(database)/documents/rmCampanhas/$(campanhaId)/grid/atual;
      return exists(ponteiro) && get(ponteiro).data.get('cenaAtivaId', null) == cenaId;
    }

    // Jogador da mesa olhando a cena ativa.
    function veCenaDoGrid(campanhaId, cenaId) {
      return isMembroDoChat(campanhaId) && gridCenaAtiva(campanhaId, cenaId);
    }

    function gridCenaValida(data) {
      return data.keys().hasOnly(['nome', 'imagemUrl', 'celula', 'deslocamentoX', 'deslocamentoY',
                                  'mostrarGrade', 'corGrade', 'opacidadeGrade', 'metrosPorQuadrado',
                                  'multiplicadorCorrida', 'travamento',
                                  'createdAt', 'updatedAt']) &&
        data.nome is string && data.nome.size() > 0 && data.nome.size() <= 100 &&
        gridImagemValida(data.get('imagemUrl', null)) &&
        data.celula is int && data.celula >= 10 && data.celula <= 400 &&
        data.deslocamentoX is int && data.deslocamentoX >= 0 && data.deslocamentoX <= 400 &&
        data.deslocamentoY is int && data.deslocamentoY >= 0 && data.deslocamentoY <= 400 &&
        data.mostrarGrade is bool &&
        data.corGrade is string && data.corGrade.matches('#[0-9a-fA-F]{6}') &&
        data.opacidadeGrade is number && data.opacidadeGrade >= 0 && data.opacidadeGrade <= 1 &&
        data.get('metrosPorQuadrado', 1.5) is number &&
        data.get('metrosPorQuadrado', 1.5) >= 0.1 && data.get('metrosPorQuadrado', 1.5) <= 100 &&
        data.get('multiplicadorCorrida', 2) in [2, 1.5] &&
        data.get('travamento', 'livre') in ['livre', 'turno', 'congelado'];
    }

    function gridPosicaoValida(data) {
      return data.col is int && data.col >= 0 && data.col <= 500 &&
        data.lin is int && data.lin >= 0 && data.lin <= 500;
    }

    // Rastro do último movimento (common/utils/grid.js — RASTRO_VERTICES_MAX):
    // polilinha de células [{col, lin}] gravada junto com a posição; `movidoEm`
    // = horário do servidor desse movimento. Sem laços nas regras: só o tamanho
    // da lista é limitado — quem lê sanitiza (normalizarRastro).
    function gridRastroValido(data) {
      return (!('rastro' in data) || (data.rastro is list && data.rastro.size() <= 50)) &&
        (!('movidoEm' in data) || data.movidoEm is timestamp);
    }

    // Movimento novo grava `movidoEm` com o horário do servidor.
    function gridMovidoEmValido(antes, depois) {
      return !depois.diff(antes).affectedKeys().hasAny(['movidoEm']) ||
        depois.movidoEm == request.time;
    }

    // Recursos do token (common/utils/grid.js — normalizarRecurso): {atual, max}
    // inteiros, 0 ≤ atual ≤ max, 1 ≤ max ≤ 99999; null = sem barra.
    function gridRecursoValido(valor) {
      return valor == null ||
        (valor is map && valor.keys().hasOnly(['atual', 'max']) &&
         valor.keys().hasAll(['atual', 'max']) &&
         valor.atual is int && valor.max is int &&
         valor.max >= 1 && valor.max <= 99999 &&
         valor.atual >= 0 && valor.atual <= valor.max);
    }

    // Aura (normalizarAura): raio em células 1–999 e cor #RRGGBB; null = sem.
    function gridAuraValida(aura) {
      return aura == null ||
        (aura is map && aura.keys().hasOnly(['raio', 'cor']) && aura.keys().hasAll(['raio', 'cor']) &&
         aura.raio is int && aura.raio >= 1 && aura.raio <= 999 &&
         aura.cor is string && aura.cor.matches('#[0-9a-fA-F]{6}'));
    }

    // Campos de combate (só o mestre grava; o jogador nunca os altera).
    // `condicoes` = ids do catálogo — sem laços, só o tamanho é limitado
    // (quem lê sanitiza: normalizarCondicoesDoToken).
    function gridCombateValido(data) {
      return gridRecursoValido(data.get('pv', null)) &&
        gridRecursoValido(data.get('energia', null)) &&
        gridRecursoValido(data.get('fadiga', null)) &&
        data.get('mostrarRecursos', 'oculto') in ['oculto', 'barra', 'numeros'] &&
        data.get('condicoes', []) is list && data.get('condicoes', []).size() <= 20 &&
        gridAuraValida(data.get('aura', null)) &&
        data.get('deslocamento', 9) is number &&
        data.get('deslocamento', 9) >= 0 && data.get('deslocamento', 9) <= 999;
    }

    function gridTokenValido(data) {
      return data.keys().hasOnly(['nome', 'imagemUrl', 'tipo', 'refId', 'col', 'lin', 'tamanho',
                                  'donos', 'oculto', 'rastro', 'movidoEm',
                                  'pv', 'energia', 'fadiga', 'mostrarRecursos', 'condicoes', 'aura',
                                  'deslocamento',
                                  'createdAt', 'updatedAt']) &&
        data.keys().hasAll(['nome', 'tipo', 'col', 'lin', 'tamanho', 'donos', 'oculto']) &&
        data.nome is string && data.nome.size() > 0 && data.nome.size() <= 100 &&
        gridImagemValida(data.get('imagemUrl', null)) &&
        data.tipo in ['jogador', 'npc', 'criatura', 'avulso'] &&
        (data.get('refId', null) == null ||
         (data.refId is string && data.refId.size() <= 200)) &&
        gridPosicaoValida(data) &&
        data.tamanho is int && data.tamanho >= 1 && data.tamanho <= 10 &&
        data.donos is list && data.donos.size() <= 20 &&
        data.oculto is bool &&
        gridRastroValido(data) &&
        gridCombateValido(data);
    }

    // Ponteiro da cena ativa (null = nenhuma cena visível aos jogadores).
    match /rmCampanhas/{campanhaId}/grid/{gridId} {
      allow read: if isMestreDaCampanha(campanhaId) || isMembroDoChat(campanhaId);
      allow create, update: if gridId == 'atual' && isMestreDaCampanha(campanhaId) &&
        request.resource.data.keys().hasOnly(['cenaAtivaId', 'updatedAt']) &&
        (request.resource.data.get('cenaAtivaId', null) == null ||
         (request.resource.data.cenaAtivaId is string &&
          request.resource.data.cenaAtivaId.size() <= 200));
      allow delete: if isMestreDaCampanha(campanhaId);
    }

    match /rmCampanhas/{campanhaId}/gridCenas/{cenaId} {
      allow read: if isMestreDaCampanha(campanhaId) || veCenaDoGrid(campanhaId, cenaId);
      allow create, update: if isMestreDaCampanha(campanhaId) &&
        gridCenaValida(request.resource.data);
      allow delete: if isMestreDaCampanha(campanhaId);
    }

    // Travar movimento (cena `travamento`): 'congelado' = só o mestre; 'turno' =
    // em combate, só o token da vez (fora de combate, livre).
    function gridMovimentoLiberado(campanhaId, cenaId, tokenId) {
      let base = /databases/$(database)/documents/rmCampanhas/$(campanhaId)/gridCenas/$(cenaId);
      let combate = /databases/$(database)/documents/rmCampanhas/$(campanhaId)/gridCenas/$(cenaId)/combate/atual;
      let modo = get(base).data.get('travamento', 'livre');
      return modo == 'livre' ||
        (modo == 'turno' && (!exists(combate) ||
          get(combate).data.ordem[get(combate).data.indice].tokenId == tokenId));
    }

    match /rmCampanhas/{campanhaId}/gridCenas/{cenaId}/tokens/{tokenId} {
      allow read: if isMestreDaCampanha(campanhaId) ||
        (resource.data.oculto == false && veCenaDoGrid(campanhaId, cenaId));
      allow create: if isMestreDaCampanha(campanhaId) && gridTokenValido(request.resource.data);
      allow update: if (isMestreDaCampanha(campanhaId) && gridTokenValido(request.resource.data) &&
                        gridMovidoEmValido(resource.data, request.resource.data)) ||
        (isAuth() && request.auth.uid in resource.data.donos &&
         resource.data.oculto == false &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['col', 'lin', 'updatedAt', 'rastro', 'movidoEm']) &&
         request.resource.data.updatedAt == request.time &&
         gridPosicaoValida(request.resource.data) &&
         gridRastroValido(request.resource.data) &&
         gridMovidoEmValido(resource.data, request.resource.data) &&
         veCenaDoGrid(campanhaId, cenaId) &&
         gridMovimentoLiberado(campanhaId, cenaId, tokenId));
      allow delete: if isMestreDaCampanha(campanhaId);
    }

    // Sinal no mapa: um doc por pessoa (id = uid), sobrescrito a cada sinal —
    // x/y em px do mundo (common/utils/grid.js — PING_COORDENADA_MAX);
    // `puxar` (centraliza a vista de todos) só o mestre; criadoEm = servidor.
    function gridPingValido(campanhaId, data) {
      return data.keys().hasOnly(['x', 'y', 'puxar', 'nome', 'criadoEm']) &&
        data.keys().hasAll(['x', 'y', 'puxar', 'criadoEm']) &&
        data.x is int && data.x >= 0 && data.x <= 250000 &&
        data.y is int && data.y >= 0 && data.y <= 250000 &&
        data.puxar is bool && (data.puxar == false || isMestreDaCampanha(campanhaId)) &&
        (!('nome' in data) || (data.nome is string && data.nome.size() <= 100)) &&
        data.criadoEm == request.time;
    }

    match /rmCampanhas/{campanhaId}/gridCenas/{cenaId}/pings/{pingUid} {
      allow read: if isMestreDaCampanha(campanhaId) || veCenaDoGrid(campanhaId, cenaId);
      allow create, update: if isAuth() && pingUid == request.auth.uid &&
        (isMestreDaCampanha(campanhaId) || veCenaDoGrid(campanhaId, cenaId)) &&
        gridPingValido(campanhaId, request.resource.data);
      allow delete: if isAuth() &&
        (pingUid == request.auth.uid || isMestreDaCampanha(campanhaId));
    }

    // Combate da cena (common/utils/gridCombate.js): um doc `combate/atual`
    // enquanto há combate. O mestre grava tudo; o jogador só passa a vez do
    // token dele que está jogando (índice +1, ou volta a 0 com rodada +1).
    function gridInicioTurnoValido(p) {
      return p == null || (p is map && p.keys().hasOnly(['col', 'lin']) &&
        p.keys().hasAll(['col', 'lin']) && gridPosicaoValida(p));
    }

    function gridCombateDaCenaValido(data) {
      return data.keys().hasOnly(['ordem', 'indice', 'rodada', 'inicioTurno', 'turnoEm',
                                  'createdAt', 'updatedAt']) &&
        data.keys().hasAll(['ordem', 'indice', 'rodada', 'turnoEm']) &&
        data.ordem is list && data.ordem.size() >= 1 && data.ordem.size() <= 200 &&
        data.indice is int && data.indice >= 0 && data.indice < data.ordem.size() &&
        data.rodada is int && data.rodada >= 1 && data.rodada <= 9999 &&
        gridInicioTurnoValido(data.get('inicioTurno', null)) &&
        data.turnoEm is timestamp;
    }

    function gridPassaMeuTurno(campanhaId, cenaId, antes, depois) {
      let daVez = get(/databases/$(database)/documents/rmCampanhas/$(campanhaId)/gridCenas/$(cenaId)/tokens/$(antes.ordem[antes.indice].tokenId)).data;
      let ultimo = antes.indice == antes.ordem.size() - 1;
      return depois.diff(antes).affectedKeys()
          .hasOnly(['indice', 'rodada', 'inicioTurno', 'turnoEm', 'updatedAt']) &&
        request.auth.uid in daVez.donos && daVez.oculto == false &&
        ((!ultimo && depois.indice == antes.indice + 1 && depois.rodada == antes.rodada) ||
         (ultimo && depois.indice == 0 && depois.rodada == antes.rodada + 1)) &&
        depois.turnoEm == request.time && depois.updatedAt == request.time;
    }

    match /rmCampanhas/{campanhaId}/gridCenas/{cenaId}/combate/{combateId} {
      allow read: if isMestreDaCampanha(campanhaId) || veCenaDoGrid(campanhaId, cenaId);
      allow create: if combateId == 'atual' && isMestreDaCampanha(campanhaId) &&
        gridCombateDaCenaValido(request.resource.data);
      allow update: if combateId == 'atual' && gridCombateDaCenaValido(request.resource.data) &&
        (isMestreDaCampanha(campanhaId) ||
         (veCenaDoGrid(campanhaId, cenaId) &&
          gridPassaMeuTurno(campanhaId, cenaId, resource.data, request.resource.data)));
      allow delete: if isMestreDaCampanha(campanhaId);
    }

    // ── Templates de área (Fase 3C — common/utils/gridAreas.js) ───────────────
    // Um doc por área (raio/linha/cone/quadrado) desenhada no mapa. `metros` é a
    // verdade (os quadrados vêm da escala da cena). Qualquer um que veja a cena
    // cria; o autor (ou o mestre) move/apaga. Só origem/alvo mudam no update.
    function gridCelulaValida(p) {
      return p is map && p.keys().hasOnly(['col', 'lin']) && p.keys().hasAll(['col', 'lin']) &&
        gridPosicaoValida(p);
    }

    function gridAreaValida(data) {
      return data.keys().hasOnly(['uid', 'nome', 'forma', 'origem', 'alvo', 'metros', 'cor',
                                  'createdAt', 'updatedAt']) &&
        data.keys().hasAll(['uid', 'forma', 'origem', 'metros', 'cor', 'createdAt', 'updatedAt']) &&
        data.forma in ['raio', 'linha', 'cone', 'quadrado'] &&
        gridCelulaValida(data.origem) &&
        (!('alvo' in data) || data.alvo == null || gridCelulaValida(data.alvo)) &&
        data.metros is number && data.metros > 0 && data.metros <= 1000 &&
        data.cor is string && data.cor.matches('#[0-9a-fA-F]{6}') &&
        (!('nome' in data) || (data.nome is string && data.nome.size() <= 100));
    }

    match /rmCampanhas/{campanhaId}/gridCenas/{cenaId}/templates/{areaId} {
      allow read: if isMestreDaCampanha(campanhaId) || veCenaDoGrid(campanhaId, cenaId);
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid &&
        (isMestreDaCampanha(campanhaId) || veCenaDoGrid(campanhaId, cenaId)) &&
        gridAreaValida(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isAuth() &&
        (resource.data.uid == request.auth.uid || isMestreDaCampanha(campanhaId)) &&
        (isMestreDaCampanha(campanhaId) || veCenaDoGrid(campanhaId, cenaId)) &&
        gridAreaValida(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['origem', 'alvo', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isAuth() &&
        (resource.data.uid == request.auth.uid || isMestreDaCampanha(campanhaId));
    }

    // ── Mapa (Fase 3B): paredes/névoa, marcadores e desenhos da cena ──────────
    // `camadas/paredes` = {trechos}; `camadas/nevoa` = {ativa, trechos(reveladas)}.
    // `trechos` = 'lin:ini-fim,ini-fim;lin:...' (common/utils/gridCamadas.js).
    // Só o mestre grava; quem lê sanitiza (decodificarTrechos).
    function gridCamadaValida(camadaId, data) {
      return (camadaId == 'paredes' &&
          data.keys().hasOnly(['trechos', 'updatedAt']) && data.keys().hasAll(['trechos']) &&
          data.trechos is string && data.trechos.size() <= 200000) ||
        (camadaId == 'nevoa' &&
          data.keys().hasOnly(['ativa', 'trechos', 'updatedAt']) &&
          data.keys().hasAll(['ativa', 'trechos']) &&
          data.ativa is bool && data.trechos is string && data.trechos.size() <= 200000);
    }

    match /rmCampanhas/{campanhaId}/gridCenas/{cenaId}/camadas/{camadaId} {
      allow read: if isMestreDaCampanha(campanhaId) || veCenaDoGrid(campanhaId, cenaId);
      allow create, update: if isMestreDaCampanha(campanhaId) &&
        gridCamadaValida(camadaId, request.resource.data);
      allow delete: if isMestreDaCampanha(campanhaId);
    }

    // Marcadores (common/utils/gridMarcadores.js): `secreto` = só o mestre lê
    // (a consulta do jogador filtra `secreto == false`, como os tokens `oculto`).
    function gridMarcadorValido(data) {
      return data.keys().hasOnly(['col', 'lin', 'icone', 'cor', 'titulo', 'texto', 'secreto',
                                  'createdAt', 'updatedAt']) &&
        data.keys().hasAll(['col', 'lin', 'icone', 'cor', 'titulo', 'secreto']) &&
        gridPosicaoValida(data) &&
        data.icone in ['alfinete', 'perigo', 'tesouro', 'porta', 'interrogacao', 'caveira'] &&
        data.cor is string && data.cor.matches('#[0-9a-fA-F]{6}') &&
        data.titulo is string && data.titulo.size() > 0 && data.titulo.size() <= 60 &&
        data.get('texto', '') is string && data.get('texto', '').size() <= 500 &&
        data.secreto is bool;
    }

    match /rmCampanhas/{campanhaId}/gridCenas/{cenaId}/marcadores/{marcadorId} {
      allow read: if isMestreDaCampanha(campanhaId) ||
        (resource.data.secreto == false && veCenaDoGrid(campanhaId, cenaId));
      allow create, update: if isMestreDaCampanha(campanhaId) &&
        gridMarcadorValido(request.resource.data);
      allow delete: if isMestreDaCampanha(campanhaId);
    }

    // Desenhos (common/utils/gridDesenho.js): um doc por traço, `pontos` plano
    // [x0,y0,x1,y1,...] em px do mundo. Cada um cria os seus; só o autor (ou o
    // mestre) apaga; não há update. O limite por pessoa é do cliente.
    function gridDesenhoValido(data) {
      return data.keys().hasOnly(['uid', 'cor', 'pontos', 'createdAt']) &&
        data.keys().hasAll(['uid', 'cor', 'pontos', 'createdAt']) &&
        data.uid == request.auth.uid &&
        data.cor is string && data.cor.matches('#[0-9a-fA-F]{6}') &&
        data.pontos is list && data.pontos.size() >= 4 && data.pontos.size() <= 400 &&
        data.pontos.size() % 2 == 0 &&
        data.createdAt == request.time;
    }

    match /rmCampanhas/{campanhaId}/gridCenas/{cenaId}/desenhos/{desenhoId} {
      allow read: if isMestreDaCampanha(campanhaId) || veCenaDoGrid(campanhaId, cenaId);
      allow create: if isAuth() &&
        (isMestreDaCampanha(campanhaId) || veCenaDoGrid(campanhaId, cenaId)) &&
        gridDesenhoValido(request.resource.data);
      allow delete: if isAuth() &&
        (isMestreDaCampanha(campanhaId) ||
         (resource.data.uid == request.auth.uid && veCenaDoGrid(campanhaId, cenaId)));
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Música da mesa (common/utils/audioMesa.js) — faixa do YouTube tocando
    // para todos com o chat da campanha aberto. Mesmo acesso do chat para
    // ler; só o mestre grava. `referenciaEm` = horário do servidor na gravação
    // (cada cliente calcula a posição atual a partir dele).
    // ═══════════════════════════════════════════════════════════════════════

    function audioMesaValido(data) {
      return data.keys().hasOnly(['videoId', 'estado', 'posicaoBase', 'repetir',
                                  'referenciaEm', 'updatedAt']) &&
        data.keys().hasAll(['videoId', 'estado', 'posicaoBase', 'repetir', 'referenciaEm']) &&
        ((data.videoId == null && data.estado == 'parado') ||
         (data.videoId is string && data.videoId.matches('[A-Za-z0-9_-]{11}') &&
          data.estado in ['tocando', 'pausado'])) &&
        data.posicaoBase is number && data.posicaoBase >= 0 && data.posicaoBase <= 86400 &&
        data.repetir is bool &&
        data.referenciaEm == request.time;
    }

    match /rmCampanhas/{campanhaId}/audio/{audioId} {
      allow read: if isMestreDaCampanha(campanhaId) || isMembroDoChat(campanhaId);
      allow create, update: if audioId == 'atual' && isMestreDaCampanha(campanhaId) &&
        audioMesaValido(request.resource.data);
      allow delete: if isMestreDaCampanha(campanhaId);
    }
  }
}
