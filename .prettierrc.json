{
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "htmlWhitespaceSensitivity": "css",
  "insertPragma": false,
  "jsxBracketSameLine": false,
  "jsxSingleQuote": false,
  "printWidth": 80,
  "proseWrap": "always",
  "quoteProps": "as-needed",
  "requirePragma": false,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
  "overrides": [
    {
      "files": [
        "src/components/Chat/**",
        "src/components/Grid/**",
        "src/components/ImageLightbox/**",
        "src/common/lua/**",
        "src/common/utils/chat*.js",
        "src/common/utils/grid*.js",
        "src/hooks/useAudioMesa.js",
        "src/hooks/useAvisarAcoesChat*.js",
        "src/hooks/useChatCampanha.js",
        "src/hooks/useFichasDoGrid*.js",
        "src/hooks/useGrid*.js",
        "src/hooks/useMembroDoChat.js",
        "src/hooks/useRolarDoToken*.js",
        "scripts/check-shared.mjs"
      ],
      "options": {
        "printWidth": 90
      }
    }
  ]
}
