[debug] [2026-10-22T06:46:54.473Z] <<< [apiv2][status] POST https://firebaserules.googleapis.com/v1/projects/re-dungeon-banco-de-dados/rulesets 200
[debug] [2026-10-22T06:46:54.474Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/re-dungeon-banco-de-dados/rulesets {"name":"projects/re-dungeon-banco-de-dados/rulesets/67ccd094-2e83-4143-8ba5-bb6bde31ab03","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    // ── Helpers ────────────────────────────────────────────────────────────────\r\n\r\n    function isAuth() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function perms() {\r\n      return get(/databases/$(database)/documents/userPermissions/$(request.auth.uid)).data;\r\n    }\r\n\r\n    function isAdmin() {\r\n      return isAuth() && perms().isAdmin == true;\r\n    }\r\n\r\n    function canWriteUniverso(universoId) {\r\n      return isAdmin() ||\r\n             (isAuth() && universoId in perms().universos);\r\n    }\r\n\r\n    // Aptidões, Regras e Condições podem pertencer a mais de um universo\r\n    // (`universos`, lista de ids); docs antigos ainda podem ter apenas o\r\n    // campo singular `universo`.\r\n    // Lista vazia é tratada como \"sem universo\" (não editável por não-admin):\r\n    // `[].hasOnly(x)` é vacuamente verdadeiro em CEL, então sem o check de\r\n    // `size() > 0` qualquer usuário autenticado — mesmo sem nenhum universo\r\n    // liberado — passaria nesta checagem.\r\n    function canWriteUniversos(universoIds) {\r\n      return isAdmin() ||\r\n             (isAuth() && universoIds.size() > 0 && universoIds.hasOnly(perms().universos));\r\n    }\r\n\r\n    // O fallback do campo singular `universo` só se aplica quando o doc não\r\n    // tem `universos` como lista — se `universos` existe (mesmo vazia), ela é\r\n    // a fonte da verdade. Sem essa exclusão, um doc migrado que ainda carrega\r\n    // os dois campos (`universos: [A,B,C]` e o antigo `universo: \"A\"`) seria\r\n    // liberado para quem só tem acesso a A, ignorando que B e C exigem\r\n    // permissão própria.\r\n    function canWriteMultiUniversoData(data) {\r\n      return isAdmin() ||\r\n        (isAuth() && (\r\n          (data.universos is list && data.universos.size() > 0 && data.universos.hasOnly(perms().universos)) ||\r\n          (!(data.universos is list) && data.universo is string && data.universo in perms().universos)\r\n        ));\r\n    }\r\n\r\n    // Permite atualizar só o campo `universos` (add/remove) de um doc\r\n    // multi-universo sem exigir acesso a todos os universos já presentes —\r\n    // basta ter acesso aos universos que estão sendo adicionados/removidos.\r\n    // Usado para permitir que um usuário associe/desassocie um doc (ex.:\r\n    // Aptidões) do(s) universo(s) que ele administra, mesmo que o doc já\r\n    // pertença a outros universos que ele não administra.\r\n    function canTogglePartialUniverso(antes, depois) {\r\n      return isAuth() &&\r\n        antes.universos is list && depois.universos is list &&\r\n        depois.diff(antes).affectedKeys().hasOnly(['universos', 'updatedAt']) &&\r\n        depois.universos.removeAll(antes.universos).hasOnly(perms().universos) &&\r\n        antes.universos.removeAll(depois.universos).hasOnly(perms().universos);\r\n    }\r\n\r\n    // ── userPermissions ────────────────────────────────────────────────────────\r\n    // Cada usuário lê o próprio documento; além disso, quem compartilha\r\n    // permissão de escrita em pelo menos um Universo com o dono do doc também\r\n    // pode ler (usado pelo Re:Master para resolver uid → nome do usuário que\r\n    // criou uma ficha de NPC/Criatura/Jogador, quando esse usuário não é quem\r\n    // está logado). Apenas admins podem escrever.\r\n    match /userPermissions/{userId} {\r\n      allow read: if isAuth() && (\r\n        request.auth.uid == userId ||\r\n        isAdmin() ||\r\n        (resource.data.universos is list &&\r\n         resource.data.universos.hasAny(perms().universos))\r\n      );\r\n      allow write: if isAdmin();\r\n    }\r\n\r\n    // ── Universo ───────────────────────────────────────────────────────────────\r\n    // Leitura para qualquer usuário autenticado; escrita apenas para admins.\r\n    match /Universo/{universoId} {\r\n      allow read: if isAuth();\r\n      allow write: if isAdmin();\r\n    }\r\n\r\n    // ── racas ──────────────────────────────────────────────────────────────────\r\n    // Leitura para qualquer usuário autenticado.\r\n    // Escrita (create/update/delete) baseada no campo `universo` do documento.\r\n    // - create: o universo do novo doc deve ser permitido ao usuário\r\n    // - update: o universo do doc antigo E do novo devem ser permitidos\r\n    //           (impede mover uma raça para outro universo sem permissão)\r\n    // - delete: o universo do doc existente deve ser permitido\r\n    match /racas/{racaId} {\r\n      allow read: if isAuth();\r\n      allow create: if canWriteUniverso(request.resource.data.universo);\r\n      allow update: if canWriteUniverso(resource.data.universo)\r\n                    && canWriteUniverso(request.resource.data.universo);\r\n      allow delete: if canWriteUniverso(resource.data.universo);\r\n    }\r\n\r\n    // ── classes ────────────────────────────────────────────────────────────────\r\n    match /classes/{classeId} {\r\n      allow read: if isAuth();\r\n      allow create: if canWriteUniverso(request.resource.data.universo);\r\n      allow update: if canWriteUniverso(resource.data.universo)\r\n                    && canWriteUniverso(request.resource.data.universo);\r\n      allow delete: if canWriteUniverso(resource.data.universo);\r\n    }\r\n\r\n    // ── materiais ──────────────────────────────────────────────────────────────\r\n    match /materiais/{materialId} {\r\n      allow read: if isAuth();\r\n      allow create: if canWriteUniverso(request.resource.data.universo);\r\n      allow update: if canWriteUniverso(resource.data.universo)\r\n                    && canWriteUniverso(request.resource.data.universo);\r\n      allow delete: if canWriteUniverso(resource.data.universo);\r\n    }\r\n\r\n    // ── itens ──────────────────────────────────────────────────────────────────\r\n    match /itens/{itemId} {\r\n      allow read: if isAuth();\r\n      allow create: if canWriteUniverso(request.resource.data.universo);\r\n      allow update: if canWriteUniverso(resource.data.universo)\r\n                    && canWriteUniverso(request.resource.data.universo);\r\n      allow delete: if canWriteUniverso(resource.data.universo);\r\n    }\r\n\r\n    // ── receitas ───────────────────────────────────────────────────────────────\r\n    match /receitas/{receitaId} {\r\n      allow read: if isAuth();\r\n      allow create: if canWriteUniverso(request.resource.data.universo);\r\n      allow update: if canWriteUniverso(resource.data.universo)\r\n                    && canWriteUniverso(request.resource.data.universo);\r\n      allow delete: if canWriteUniverso(resource.data.universo);\r\n    }\r\n\r\n    // ── condicoes ──────────────────────────────────────────────────────────────\r\n    // Escrita baseada no campo `universos` (lista de ids) do documento —\r\n    // condições podem pertencer a mais de um universo.\r\n    match /condicoes/{condicaoId} {\r\n      allow read: if isAuth();\r\n      allow create: if canWriteUniversos(request.resource.data.universos);\r\n      allow update: if canWriteMultiUniversoData(resource.data)\r\n                    && canWriteUniversos(request.resource.data.universos);\r\n      allow delete: if canWriteMultiUniversoData(resource.data);\r\n    }\r\n\r\n    // ── artes ──────────────────────────────────────────────────────────────────\r\n    match /artes/{arteId} {\r\n      allow read: if isAuth();\r\n      allow create: if canWriteUniverso(request.resource.data.universo);\r\n      allow update: if canWriteUniverso(resource.data.universo)\r\n                    && canWriteUniverso(request.resource.data.universo);\r\n      allow delete: if canWriteUniverso(resource.data.universo);\r\n    }\r\n\r\n    // ── origens ────────────────────────────────────────────────────────────────\r\n    match /origens/{origemId} {\r\n      allow read: if isAuth();\r\n      allow create: if canWriteUniverso(request.resource.data.universo);\r\n      allow update: if canWriteUniverso(resource.data.universo)\r\n                    && canWriteUniverso(request.resource.data.universo);\r\n      allow delete: if canWriteUniverso(resource.data.universo);\r\n    }\r\n\r\n    // ── regras ─────────────────────────────────────────────────────────────────\r\n    // Escrita baseada no campo `universos` (lista de ids) do documento —\r\n    // regras podem pertencer a mais de um universo.\r\n    match /regras/{regraId} {\r\n      allow read: if isAuth();\r\n      allow create: if canWriteUniversos(request.resource.data.universos);\r\n      allow update: if canWriteMultiUniversoData(resource.data)\r\n                    && canWriteUniversos(request.resource.data.universos);\r\n      allow delete: if canWriteMultiUniversoData(resource.data);\r\n    }\r\n\r\n    // ── cardflux ───────────────────────────────────────────────────────────────\r\n    match /cardflux/{cardFluxId} {\r\n      allow read: if isAuth();\r\n      allow create: if canWriteUniverso(request.resource.data.universo);\r\n      allow update: if canWriteUniverso(resource.data.universo)\r\n                    && canWriteUniverso(request.resource.data.universo);\r\n      allow delete: if canWriteUniverso(resource.data.universo);\r\n    }\r\n\r\n    // ── veiasAstrais ───────────────────────────────────────────────────────────\r\n    match /veiasAstrais/{veiaAstralId} {\r\n      allow read: if isAuth();\r\n      allow create: if canWriteUniverso(request.resource.data.universo);\r\n      allow update: if canWriteUniverso(resource.data.universo)\r\n                    && canWriteUniverso(request.resource.data.universo);\r\n      allow delete: if canWriteUniverso(resource.data.universo);\r\n    }\r\n\r\n    // ── divindades ─────────────────────────────────────────────────────────────\r\n    match /divindades/{divindadeId} {\r\n      allow read: if isAuth();\r\n      allow create: if canWriteUniverso(request.resource.data.universo);\r\n      allow update: if canWriteUniverso(resource.data.universo)\r\n                    && canWriteUniverso(request.resource.data.universo);\r\n      allow delete: if canWriteUniverso(resource.data.universo);\r\n    }\r\n\r\n    // ── aptidoes ───────────────────────────────────────────────────────────────\r\n    // Escrita baseada no campo `universos` (lista de ids) do documento —\r\n    // aptidões podem pertencer a mais de um universo.\r\n    match /aptidoes/{aptidaoId} {\r\n      allow read: if isAuth();\r\n      allow create: if canWriteUniversos(request.resource.data.universos);\r\n      allow update: if (canWriteMultiUniversoData(resource.data)\r\n                    && canWriteUniversos(request.resource.data.universos))\r\n                    || canTogglePartialUniverso(resource.data, request.resource.data);\r\n      allow delete: if canWriteMultiUniversoData(resource.data);\r\n    }\r\n\r\n    // ── corposEspeciais ──────────────────────────────────────────────────────\r\n    match /corposEspeciais/{corpoEspecialId} {\r\n      allow read: if isAuth();\r\n      allow create: if canWriteUniverso(request.resource.data.universo);\r\n      allow update: if canWriteUniverso(resource.data.universo)\r\n                    && canWriteUniverso(request.resource.data.universo);\r\n      allow delete: if canWriteUniverso(resource.data.universo);\r\n    }\r\n\r\n    // ── reinosCultivo ────────────────────────────────────────────────────────\r\n    match /reinosCultivo/{reinoCultivoId} {\r\n      allow read: if isAuth();\r\n      allow create: if canWriteUniverso(request.resource.data.universo);\r\n      allow update: if canWriteUniverso(resource.data.universo)\r\n                    && canWriteUniverso(request.resource.data.universo);\r\n      allow delete: if canWriteUniverso(resource.data.universo);\r\n    }\r\n\r\n    // ── tricksterCoin ───────────────────────────────────────────────────────\r\n    // Coleção administrativa de benefícios da Trickster Coin. O acesso é\r\n    // restrito ao mesmo gate de administração já usado pelo banco:\r\n    // usuário autenticado + documento `userPermissions/{uid}` com `isAdmin == true`.\r\n    match /tricksterCoin/{benefitId} {\r\n      allow read: if isAuth();\r\n      allow create: if isAdmin();\r\n      allow update: if isAdmin();\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    // ── personagens ──────────────────────────────────────────────────────\r\n    // Cada usuário só escreve os próprios personagens (uid == request.auth.uid).\r\n    // Leitura liberada para qualquer autenticado, independente do `tipo`: NPC\r\n    // e Criatura já eram públicos como conteúdo de referência para o\r\n    // Re:Master importar; \"Personagem Jogável\" também precisa ser legível por\r\n    // qualquer mestre autenticado para a tela de Jogadores do Re:Master (lista\r\n    // de personagens jogáveis vinculados a uma campanha, via campo\r\n    // `campanhas`) — não há como restringir a leitura só ao mestre dono da\r\n    // campanha vinculada sem iterar `campanhas` em regra, o que a linguagem\r\n    // de regras do Firestore não suporta.\r\n    match /personagens/{personagemId} {\r\n      allow read: if isAuth();\r\n      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;\r\n      allow update: if isAuth() && resource.data.uid == request.auth.uid\r\n                    && request.resource.data.uid == request.auth.uid;\r\n      allow delete: if isAuth() && resource.data.uid == request.auth.uid;\r\n\r\n      // Subcoleções (aptidoesAdquiridas, arts, historicoSorte — Fases futuras).\r\n      // Escrita: só o dono do documento pai (uid), como antes.\r\n      // Leitura: dono OU qualquer usuário com permissão de escrita no Universo\r\n      // do personagem (`data.universo`) — liberado para o Re:Master mostrar a\r\n      // ficha completa de NPCs/Criaturas importados de outro autor dentro do\r\n      // mesmo Universo (antes só o dono via Re-Dungeon enxergava essas abas).\r\n      match /{subcolecao}/{docId} {\r\n        allow read: if isAuth() &&\r\n          (get(/databases/$(database)/documents/personagens/$(personagemId)).data.uid\r\n             == request.auth.uid ||\r\n           canWriteUniverso(\r\n             get(/databases/$(database)/documents/personagens/$(personagemId)).data.universo));\r\n        allow write: if isAuth()\r\n          && get(/databases/$(database)/documents/personagens/$(personagemId)).data.uid\r\n             == request.auth.uid;\r\n      }\r\n    }\r\n\r\n    // ═══════════════════════════════════════════════════════════════════════\r\n    // Re:Master — coleções novas (prefixo `rm`), acrescentadas sem alterar\r\n    // nenhuma linha acima. Diferente das coleções do Re-Dungeon (públicas\r\n    // para qualquer autenticado), o conteúdo do Re:Master é privado do\r\n    // mestre — sem visão de jogador em nenhum dos módulos atuais — então\r\n    // leitura E escrita ficam restritas ao mestre dono da campanha.\r\n    // ═══════════════════════════════════════════════════════════════════════\r\n\r\n    // Cada Campanha (e tudo vinculado a ela) é privada ao mestre que a criou,\r\n    // mesmo que outro colaborador tenha acesso de escrita ao mesmo Universo —\r\n    // evita que dois mestres rodando campanhas diferentes no mesmo mundo\r\n    // vejam segredos de NPC/consequências um do outro.\r\n    function isCampanhaOwner(mestreId) {\r\n      return isAuth() && mestreId == request.auth.uid;\r\n    }\r\n\r\n    // Todo documento das coleções abaixo denormaliza `universoId` e\r\n    // `mestreId` (evita `get()` extra por regra), então a checagem é sempre a\r\n    // mesma — só muda o nome da coleção.\r\n    match /rmCampanhas/{campanhaId} {\r\n      allow read: if isAuth();\r\n      allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);\r\n      allow update: if isAdmin() ||\r\n        (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));\r\n      allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n\r\n      // Clones de NPC específicos desta campanha (feitos a partir de um\r\n      // personagem tipo NPC do Universo). Subcoleção — não coleção `rm`\r\n      // top-level — porque o clone só existe no escopo de uma Campanha; os\r\n      // docs denormalizam universoId/mestreId como as demais, então a\r\n      // checagem é idêntica à do documento pai.\r\n      match /npcs/{npcId} {\r\n        allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n        allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);\r\n        allow update: if isAdmin() ||\r\n          (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));\r\n        allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n      }\r\n\r\n      // Clones de Personagem Jogável específicos desta campanha (feitos a\r\n      // partir de um personagem tipo Personagem Jogável do Universo) — mesmo\r\n      // padrão da subcoleção `npcs` acima.\r\n      match /jogadores/{jogadorId} {\r\n        allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n        allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);\r\n        allow update: if isAdmin() ||\r\n          (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));\r\n        allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n      }\r\n\r\n      // Clones de Criatura específicos desta campanha (feitos a partir de um\r\n      // personagem tipo Criatura do Universo) — mesmo padrão das subcoleções\r\n      // `npcs`/`jogadores` acima.\r\n      match /criaturas/{criaturaId} {\r\n        allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n        allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);\r\n        allow update: if isAdmin() ||\r\n          (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));\r\n        allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n      }\r\n\r\n      // Participantes da tela de Luta desta campanha (cópias de NPC/Criatura\r\n      // com estado de combate próprio, inclusive duplicatas do mesmo\r\n      // personagem de origem) — mesmo padrão das subcoleções acima.\r\n      match /lutaParticipantes/{participanteId} {\r\n        allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n        allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);\r\n        allow update: if isAdmin() ||\r\n          (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));\r\n        allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n      }\r\n    }\r\n\r\n    match /rmCenas/{docId} {\r\n      allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n      allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);\r\n      allow update: if isAdmin() ||\r\n        (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));\r\n      allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n    }\r\n\r\n    match /rmCenaConexoes/{docId} {\r\n      allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n      allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);\r\n      allow update: if isAdmin() ||\r\n        (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));\r\n      allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n    }\r\n\r\n    match /rmMapas/{docId} {\r\n      allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n      allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);\r\n      allow update: if isAdmin() ||\r\n        (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));\r\n      allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n    }\r\n\r\n    match /rmMapasPastas/{docId} {\r\n      allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n      allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);\r\n      allow update: if isAdmin() ||\r\n        (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));\r\n      allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n    }\r\n\r\n    match /rmMissoes/{docId} {\r\n      allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n      allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);\r\n      allow update: if isAdmin() ||\r\n        (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));\r\n      allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n    }\r\n\r\n    match /rmCardfluxEstados/{docId} {\r\n      allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n      allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);\r\n      allow update: if isAdmin() ||\r\n        (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));\r\n      allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n    }\r\n\r\n    match /rmCardfluxExploracoes/{docId} {\r\n      allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n      allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);\r\n      allow update: if isAdmin() ||\r\n        (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));\r\n      allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n    }\r\n\r\n    match /rmNotas/{docId} {\r\n      allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n      allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);\r\n      allow update: if isAdmin() ||\r\n        (isCampanhaOwner(resource.data.mestreId) && isCampanhaOwner(request.resource.data.mestreId));\r\n      allow delete: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n    }\r\n\r\n    match /rmTiposEntidade/{docId} {\r\n      allow read: if isAdmin() ||\r\n        (isAuth() &&\r\n          resource.data.mestreId == request.auth.uid &&\r\n          canWriteUniverso(resource.data.universoId));\r\n      allow create: if isAuth() &&\r\n        request.resource.data.mestreId == request.auth.uid &&\r\n        canWriteUniverso(request.resource.data.universoId);\r\n      allow update: if isAdmin() ||\r\n        (isAuth() &&\r\n          resource.data.mestreId == request.auth.uid &&\r\n          request.resource.data.mestreId == request.auth.uid &&\r\n          resource.data.universoId == request.resource.data.universoId &&\r\n          canWriteUniverso(request.resource.data.universoId));\r\n      allow delete: if isAdmin() ||\r\n        (isAuth() &&\r\n          resource.data.mestreId == request.auth.uid &&\r\n          canWriteUniverso(resource.data.universoId));\r\n    }\r\n\r\n    // Biblioteca global de músicas do mestre — só o dono do conteúdo pode\r\n    // publicar/editar/excluir suas músicas, pastas e playlists. A regra usa\r\n    // `mestreId` para impedir que um mestre altere registros de outro.\r\n    function musicaBibliotecaValida(data) {\r\n      return data.keys().hasOnly(['nome', 'url', 'videoId', 'pastaId', 'tags', 'descricao',\r\n                                  'thumbnailUrl', 'duracaoSegundos', 'mestreId', 'createdAt', 'updatedAt']) &&\r\n        data.mestreId == request.auth.uid &&\r\n        data.nome is string && data.nome.size() > 0 && data.nome.size() <= 200 &&\r\n        data.url is string && data.url.size() <= 2000 && data.url.matches('https://.+') &&\r\n        data.videoId is string && data.videoId.matches('[A-Za-z0-9_-]{11}') &&\r\n        (data.pastaId == null || (data.pastaId is string && data.pastaId.size() <= 200)) &&\r\n        data.tags is list && data.tags.size() <= 20 &&\r\n        data.descricao is string && data.descricao.size() <= 2000 &&\r\n        (data.thumbnailUrl == null || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 2000)) &&\r\n        (data.duracaoSegundos == null || (data.duracaoSegundos is number && data.duracaoSegundos >= 0));\r\n    }\r\n\r\n    function musicaPastaValida(data) {\r\n      return data.keys().hasOnly(['nome', 'descricao', 'cor', 'ordenacao', 'mestreId', 'createdAt', 'updatedAt']) &&\r\n        data.mestreId == request.auth.uid &&\r\n        data.nome is string && data.nome.size() > 0 && data.nome.size() <= 200 &&\r\n        data.descricao is string && data.descricao.size() <= 2000 &&\r\n        data.cor is string && data.cor.matches('#[0-9a-fA-F]{6}') &&\r\n        data.ordenacao is int && data.ordenacao >= 0;\r\n    }\r\n\r\n    function playlistBibliotecaValida(data) {\r\n      return data.keys().hasOnly(['nome', 'descricao', 'linkImagem', 'musicas', 'mestreId', 'createdAt', 'updatedAt']) &&\r\n        data.mestreId == request.auth.uid &&\r\n        data.nome is string && data.nome.size() > 0 && data.nome.size() <= 200 &&\r\n        data.descricao is string && data.descricao.size() <= 2000 &&\r\n        (data.linkImagem == null || (data.linkImagem is string && data.linkImagem.size() <= 2000)) &&\r\n        data.musicas is list && data.musicas.size() <= 200;\r\n    }\r\n\r\n    match /rmMusicasBiblioteca/{docId} {\r\n      allow read: if isAdmin() || (isAuth() && resource.data.mestreId == request.auth.uid);\r\n      allow create: if isAuth() && request.resource.data.mestreId == request.auth.uid && musicaBibliotecaValida(request.resource.data);\r\n      allow update: if isAdmin() ||\r\n        (isAuth() && resource.data.mestreId == request.auth.uid && request.resource.data.mestreId == request.auth.uid && musicaBibliotecaValida(request.resource.data));\r\n      allow delete: if isAdmin() || (isAuth() && resource.data.mestreId == request.auth.uid);\r\n    }\r\n\r\n    match /rmMusicasPastas/{docId} {\r\n      allow read: if isAdmin() || (isAuth() && resource.data.mestreId == request.auth.uid);\r\n      allow create: if isAuth() && request.resource.data.mestreId == request.auth.uid && musicaPastaValida(request.resource.data);\r\n      allow update: if isAdmin() ||\r\n        (isAuth() && resource.data.mestreId == request.auth.uid && request.resource.data.mestreId == request.auth.uid && musicaPastaValida(request.resource.data));\r\n      allow delete: if isAdmin() || (isAuth() && resource.data.mestreId == request.auth.uid);\r\n    }\r\n\r\n    match /rmPlaylists/{docId} {\r\n      allow read: if isAdmin() || (isAuth() && resource.data.mestreId == request.auth.uid);\r\n      allow create: if isAuth() && request.resource.data.mestreId == request.auth.uid && playlistBibliotecaValida(request.resource.data);\r\n      allow update: if isAdmin() ||\r\n        (isAuth() && resource.data.mestreId == request.auth.uid && request.resource.data.mestreId == request.auth.uid && playlistBibliotecaValida(request.resource.data));\r\n      allow delete: if isAdmin() || (isAuth() && resource.data.mestreId == request.auth.uid);\r\n    }\r\n\r\n    // Registro cronológico automático de eventos da sessão (cena marcada\r\n    // como atual, carta sorteada, participante entrou na Luta) — só leitura\r\n    // e criação (append-only por design, ver storage.js): nenhuma tela edita\r\n    // ou apaga uma entrada de log já gravada, então update/delete ficam sem\r\n    // `allow` (negados por padrão pelas Firestore Rules).\r\n    match /rmSessaoLogs/{docId} {\r\n      allow read: if isAdmin() || isCampanhaOwner(resource.data.mestreId);\r\n      allow create: if isAuth() && isCampanhaOwner(request.resource.data.mestreId);\r\n    }\r\n\r\n    // ═══════════════════════════════════════════════════════════════════════\r\n    // Chat da campanha — primeiro conteúdo `rm*` visível para jogadores.\r\n    // Acesso: o mestre da campanha (`mestreId` do doc pai) OU um jogador cujo\r\n    // personagem (dele, `uid`) tem a campanha em `campanhas`. Admin que não é\r\n    // o mestre NÃO entra (conversa de mesa é privada). Como `personagens` não\r\n    // pode ser consultado por regra, cada jogador grava um ponteiro\r\n    // `chatMembros/{uid}` = {uid, personagemId}; a leitura revalida esse\r\n    // personagem a cada request — desmarcar a campanha na ficha corta o acesso\r\n    // na hora, sem precisar apagar o ponteiro.\r\n    // ═══════════════════════════════════════════════════════════════════════\r\n\r\n    function isMestreDaCampanha(campanhaId) {\r\n      return isAuth() &&\r\n        get(/databases/$(database)/documents/rmCampanhas/$(campanhaId)).data.mestreId == request.auth.uid;\r\n    }\r\n\r\n    function personagemDoUsuarioNaCampanha(campanhaId, personagemId) {\r\n      let personagem = get(/databases/$(database)/documents/personagens/$(personagemId)).data;\r\n      return isAuth() && personagemId is string &&\r\n        personagem.uid == request.auth.uid &&\r\n        campanhaId in personagem.get('campanhas', []);\r\n    }\r\n\r\n    function isMembroDoChat(campanhaId) {\r\n      let membroPath = /databases/$(database)/documents/rmCampanhas/$(campanhaId)/chatMembros/$(request.auth.uid);\r\n      return isAuth() && exists(membroPath) &&\r\n        personagemDoUsuarioNaCampanha(campanhaId, get(membroPath).data.personagemId);\r\n    }\r\n\r\n    // Rolagem de dados (common/utils/dados.js): o dado é rolado no cliente e a\r\n    // regra só valida a ESTRUTURA — Firestore Rules não têm laços, então não\r\n    // dá para somar `resultados` nem conferir a faixa de cada dado.\r\n    function chatRolagemValida(rolagem) {\r\n      return rolagem is map &&\r\n        rolagem.keys().hasOnly(['grupos', 'termos', 'modificador', 'total']) &&\r\n        rolagem.keys().hasAll(['grupos', 'termos', 'modificador', 'total']) &&\r\n        rolagem.grupos is list && rolagem.grupos.size() >= 1 && rolagem.grupos.size() <= 10 &&\r\n        rolagem.termos is list && rolagem.termos.size() <= 20 &&\r\n        rolagem.modificador is int && rolagem.total is int;\r\n    }\r\n\r\n    // Espelha os limites de common/utils/chat.js (CHAT_TEXTO_MAX/CHAT_URL_MAX,\r\n    // PERSONAS). O mestre pode falar como 'mestre', ou interpretar um NPC/\r\n    // Criatura da mesa ('npc'/'criatura', com o nome/avatar dele em\r\n    // autorNome/autorAvatar); jogador é sempre 'jogador'.\r\n    // `secreta`: true só no caminho chatSecretas/{uid}/rolagens (o campo\r\n    // `secreta` do doc tem que bater com o caminho).\r\n    function chatMensagemValida(campanhaId, data, secreta) {\r\n      return data.keys().hasOnly(['uid', 'personagemId', 'autorNome', 'autorAvatar', 'isMestre',\r\n                                  'persona', 'tipo', 'texto', 'url', 'rolagem', 'secreta',\r\n                                  'macroNome', 'createdAt']) &&\r\n        data.uid == request.auth.uid &&\r\n        data.createdAt == request.time &&\r\n        data.get('secreta', false) == secreta &&\r\n        data.autorNome is string && data.autorNome.size() > 0 && data.autorNome.size() <= 200 &&\r\n        (data.autorAvatar == null || (data.autorAvatar is string && data.autorAvatar.size() <= 2000)) &&\r\n        data.texto is string && data.texto.size() <= 4000 &&\r\n        ((data.tipo == 'texto' && data.texto.size() > 0 && data.texto.size() <= 2000 &&\r\n          data.url == null && !data.keys().hasAny(['rolagem', 'macroNome'])) ||\r\n         (data.tipo == 'imagem' && data.texto.size() <= 2000 && data.url is string &&\r\n          data.url.size() <= 2000 && data.url.matches('https://.+') &&\r\n          !data.keys().hasAny(['rolagem', 'macroNome'])) ||\r\n         (data.tipo == 'rolagem' && data.texto == '' && data.url == null &&\r\n          !data.keys().hasAny(['macroNome']) && chatRolagemValida(data.get('rolagem', null))) ||\r\n         (data.tipo == 'macro' && data.texto.size() > 0 && data.url == null &&\r\n          !data.keys().hasAny(['rolagem']) && data.macroNome is string &&\r\n          data.macroNome.size() > 0 && data.macroNome.size() <= 100)) &&\r\n        ((data.isMestre == true && data.personagemId == null &&\r\n          data.persona in ['mestre', 'npc', 'criatura'] && isMestreDaCampanha(campanhaId)) ||\r\n         (data.isMestre == false && data.persona == 'jogador' &&\r\n          personagemDoUsuarioNaCampanha(campanhaId, data.personagemId)));\r\n    }\r\n\r\n    match /rmCampanhas/{campanhaId}/chatMembros/{membroUid} {\r\n      allow read: if isAuth() &&\r\n        (membroUid == request.auth.uid || isMestreDaCampanha(campanhaId));\r\n      allow create, update: if isAuth() && membroUid == request.auth.uid &&\r\n        request.resource.data.keys().hasOnly(['uid', 'personagemId', 'updatedAt']) &&\r\n        request.resource.data.uid == request.auth.uid &&\r\n        personagemDoUsuarioNaCampanha(campanhaId, request.resource.data.personagemId);\r\n      allow delete: if isAuth() && membroUid == request.auth.uid;\r\n    }\r\n\r\n    // Sem update: mensagens não são editáveis (v1). Apagar: autor ou mestre.\r\n    match /rmCampanhas/{campanhaId}/chatMensagens/{mensagemId} {\r\n      allow read: if isMestreDaCampanha(campanhaId) || isMembroDoChat(campanhaId);\r\n      allow create: if isAuth() && chatMensagemValida(campanhaId, request.resource.data, false);\r\n      allow delete: if isAuth() &&\r\n        (resource.data.uid == request.auth.uid || isMestreDaCampanha(campanhaId));\r\n    }\r\n\r\n    // Rolagens secretas: uma pasta por usuário — só o dono e o mestre da\r\n    // campanha leem. Os outros jogadores não ficam sabendo que houve rolagem.\r\n    match /rmCampanhas/{campanhaId}/chatSecretas/{donoUid}/rolagens/{rolagemId} {\r\n      allow read: if isAuth() &&\r\n        (donoUid == request.auth.uid || isMestreDaCampanha(campanhaId));\r\n      allow create: if isAuth() && donoUid == request.auth.uid &&\r\n        request.resource.data.tipo == 'rolagem' &&\r\n        chatMensagemValida(campanhaId, request.resource.data, true);\r\n      allow delete: if isAuth() &&\r\n        (donoUid == request.auth.uid || isMestreDaCampanha(campanhaId));\r\n    }\r\n\r\n    // Macros Lua da campanha (common/lua/ + common/utils/macros.js). Só o\r\n    // mestre cria/edita/apaga; membros leem as que não são `somenteMestre`\r\n    // (a consulta do jogador filtra `somenteMestre == false`, senão a lista\r\n    // inteira é recusada). Executar uma macro nunca grava aqui — ela roda\r\n    // isolada num Web Worker e só gera mensagens em chatMensagens.\r\n    function chatMacroValida(data) {\r\n      return data.keys().hasOnly(['nome', 'descricao', 'codigo', 'somenteMestre', 'ordem',\r\n                                  'createdAt', 'updatedAt']) &&\r\n        data.nome is string && data.nome.size() > 0 && data.nome.size() <= 100 &&\r\n        data.get('descricao', '') is string && data.get('descricao', '').size() <= 300 &&\r\n        data.codigo is string && data.codigo.size() > 0 && data.codigo.size() <= 51200 &&\r\n        data.somenteMestre is bool &&\r\n        data.ordem is int;\r\n    }\r\n\r\n    match /rmCampanhas/{campanhaId}/macros/{macroId} {\r\n      allow read: if isMestreDaCampanha(campanhaId) ||\r\n        (isMembroDoChat(campanhaId) && resource.data.somenteMestre == false);\r\n      allow create, update: if isMestreDaCampanha(campanhaId) &&\r\n        chatMacroValida(request.resource.data);\r\n      allow delete: if isMestreDaCampanha(campanhaId);\r\n    }\r\n\r\n    // ═══════════════════════════════════════════════════════════════════════\r\n    // Grid da campanha (common/utils/grid.js) — mesmo acesso do chat, em\r\n    // CENAS: `gridCenas/{cenaId}` (imagem + grade) com os próprios tokens em\r\n    // `gridCenas/{cenaId}/tokens`; `grid/atual` = {cenaAtivaId}. O mestre\r\n    // cria/edita/apaga tudo (Re:Master) e prepara cenas em segredo: o jogador\r\n    // só lê a cena ATIVA e os tokens dela, e só MOVE (col/lin) os tokens em\r\n    // que o uid dele está em `donos`. Tokens `oculto` só o mestre lê — a\r\n    // consulta do jogador filtra `oculto == false` (senão é recusada).\r\n    // ═══════════════════════════════════════════════════════════════════════\r\n\r\n    function gridImagemValida(url) {\r\n      return url == null || (url is string && url.size() <= 2000 && url.matches('https://.+'));\r\n    }\r\n\r\n    function gridCenaAtiva(campanhaId, cenaId) {\r\n      let ponteiro = /databases/$(database)/documents/rmCampanhas/$(campanhaId)/grid/atual;\r\n      return exists(ponteiro) && get(ponteiro).data.get('cenaAtivaId', null) == cenaId;\r\n    }\r\n\r\n    // Jogador da mesa olhando a cena ativa.\r\n    function veCenaDoGrid(campanhaId, cenaId) {\r\n      return isMembroDoChat(campanhaId) && gridCenaAtiva(campanhaId, cenaId);\r\n    }\r\n\r\n    function gridCenaValida(data) {\r\n      return data.keys().hasOnly(['nome', 'imagemUrl', 'celula', 'deslocamentoX', 'deslocamentoY',\r\n                                  'mostrarGrade', 'corGrade', 'opacidadeGrade',\r\n                                  'createdAt', 'updatedAt']) &&\r\n        data.nome is string && data.nome.size() > 0 && data.nome.size() <= 100 &&\r\n        gridImagemValida(data.get('imagemUrl', null)) &&\r\n        data.celula is int && data.celula >= 10 && data.celula <= 400 &&\r\n        data.deslocamentoX is int && data.deslocamentoX >= 0 && data.deslocamentoX <= 400 &&\r\n        data.deslocamentoY is int && data.deslocamentoY >= 0 && data.deslocamentoY <= 400 &&\r\n        data.mostrarGrade is bool &&\r\n        data.corGrade is string && data.corGrade.matches('#[0-9a-fA-F]{6}') &&\r\n        data.opacidadeGrade is number && data.opacidadeGrade >= 0 && data.opacidadeGrade <= 1;\r\n    }\r\n\r\n    function gridPosicaoValida(data) {\r\n      return data.col is int && data.col >= 0 && data.col <= 500 &&\r\n        data.lin is int && data.lin >= 0 && data.lin <= 500;\r\n    }\r\n\r\n    function gridTokenValido(data) {\r\n      return data.keys().hasOnly(['nome', 'imagemUrl', 'tipo', 'refId', 'col', 'lin', 'tamanho',\r\n                                  'donos', 'oculto', 'createdAt', 'updatedAt']) &&\r\n        data.keys().hasAll(['nome', 'tipo', 'col', 'lin', 'tamanho', 'donos', 'oculto']) &&\r\n        data.nome is string && data.nome.size() > 0 && data.nome.size() <= 100 &&\r\n        gridImagemValida(data.get('imagemUrl', null)) &&\r\n        data.tipo in ['jogador', 'npc', 'criatura', 'avulso'] &&\r\n        (data.get('refId', null) == null ||\r\n         (data.refId is string && data.refId.size() <= 200)) &&\r\n        gridPosicaoValida(data) &&\r\n        data.tamanho is int && data.tamanho >= 1 && data.tamanho <= 10 &&\r\n        data.donos is list && data.donos.size() <= 20 &&\r\n        data.oculto is bool;\r\n    }\r\n\r\n    // Ponteiro da cena ativa (null = nenhuma cena visível aos jogadores).\r\n    match /rmCampanhas/{campanhaId}/grid/{gridId} {\r\n      allow read: if isMestreDaCampanha(campanhaId) || isMembroDoChat(campanhaId);\r\n      allow create, update: if gridId == 'atual' && isMestreDaCampanha(campanhaId) &&\r\n        request.resource.data.keys().hasOnly(['cenaAtivaId', 'updatedAt']) &&\r\n        (request.resource.data.get('cenaAtivaId', null) == null ||\r\n         (request.resource.data.cenaAtivaId is string &&\r\n          request.resource.data.cenaAtivaId.size() <= 200));\r\n      allow delete: if isMestreDaCampanha(campanhaId);\r\n    }\r\n\r\n    match /rmCampanhas/{campanhaId}/gridCenas/{cenaId} {\r\n      allow read: if isMestreDaCampanha(campanhaId) || veCenaDoGrid(campanhaId, cenaId);\r\n      allow create, update: if isMestreDaCampanha(campanhaId) &&\r\n        gridCenaValida(request.resource.data);\r\n      allow delete: if isMestreDaCampanha(campanhaId);\r\n    }\r\n\r\n    match /rmCampanhas/{campanhaId}/gridCenas/{cenaId}/tokens/{tokenId} {\r\n      allow read: if isMestreDaCampanha(campanhaId) ||\r\n        (resource.data.oculto == false && veCenaDoGrid(campanhaId, cenaId));\r\n      allow create: if isMestreDaCampanha(campanhaId) && gridTokenValido(request.resource.data);\r\n      allow update: if (isMestreDaCampanha(campanhaId) && gridTokenValido(request.resource.data)) ||\r\n        (isAuth() && request.auth.uid in resource.data.donos &&\r\n         resource.data.oculto == false &&\r\n         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['col', 'lin', 'updatedAt']) &&\r\n         request.resource.data.updatedAt == request.time &&\r\n         gridPosicaoValida(request.resource.data) &&\r\n         veCenaDoGrid(campanhaId, cenaId));\r\n      allow delete: if isMestreDaCampanha(campanhaId);\r\n    }\r\n\r\n    // ═══════════════════════════════════════════════════════════════════════\r\n    // Música da mesa (common/utils/audioMesa.js) — faixa do YouTube tocando\r\n    // para todos com o chat da campanha aberto. Mesmo acesso do chat para\r\n    // ler; só o mestre grava. `referenciaEm` = horário do servidor na gravação\r\n    // (cada cliente calcula a posição atual a partir dele).\r\n    // ═══════════════════════════════════════════════════════════════════════\r\n\r\n    function audioMesaValido(data) {\r\n      return data.keys().hasOnly(['videoId', 'estado', 'posicaoBase', 'repetir',\r\n                                  'referenciaEm', 'updatedAt']) &&\r\n        data.keys().hasAll(['videoId', 'estado', 'posicaoBase', 'repetir', 'referenciaEm']) &&\r\n        ((data.videoId == null && data.estado == 'parado') ||\r\n         (data.videoId is string && data.videoId.matches('[A-Za-z0-9_-]{11}') &&\r\n          data.estado in ['tocando', 'pausado'])) &&\r\n        data.posicaoBase is number && data.posicaoBase >= 0 && data.posicaoBase <= 86400 &&\r\n        data.repetir is bool &&\r\n        data.referenciaEm == request.time;\r\n    }\r\n\r\n    match /rmCampanhas/{campanhaId}/audio/{audioId} {\r\n      allow read: if isMestreDaCampanha(campanhaId) || isMembroDoChat(campanhaId);\r\n      allow create, update: if audioId == 'atual' && isMestreDaCampanha(campanhaId) &&\r\n        audioMesaValido(request.resource.data);\r\n      allow delete: if isMestreDaCampanha(campanhaId);\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-10-22T06:46:54.249263Z","metadata":{"services":["cloud.firestore"]}}
